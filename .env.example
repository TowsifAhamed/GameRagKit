# GameRagKit Testing Environment Variables - EXAMPLE
# ==================================================
# Copy this file to `.env` and fill in your actual values
#
# cp .env.example .env
# nano .env  # Add your keys
# dotnet test

# ===========================================
# SKIP INTEGRATION TESTS (CI/CD mode)
# ===========================================
# SKIP_INTEGRATION_TESTS=true

# ===========================================
# OPENAI CONFIGURATION
# ===========================================
API_KEY=sk-your-openai-key-here
OPENAI_API_KEY=sk-your-openai-key-here
ENDPOINT=https://api.openai.com/
CLOUD_CHAT_MODEL=gpt-4o-mini
CLOUD_EMBED_MODEL=text-embedding-3-large

# ===========================================
# GOOGLE GEMINI CONFIGURATION (FREE TIER!)
# ===========================================
GEMINI_API_KEY=your-gemini-key-here

# ===========================================
# ANTHROPIC (CLAUDE) CONFIGURATION
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-key-here

# ===========================================
# OLLAMA (LOCAL)
# ===========================================
OLLAMA_HOST=http://localhost:11434
LOCAL_ENGINE=ollama
LOCAL_CHAT_MODEL=llama3.2:3b-instruct-q4_K_M
LOCAL_EMBED_MODEL=nomic-embed-text

# ===========================================
# POSTGRESQL (VECTOR DATABASE)
# ===========================================
DATABASE_CONNECTION=Host=localhost;Port=5432;Database=gamerag_test;Username=rag;Password=gamerag123

# ===========================================
# QDRANT (OPTIONAL)
# ===========================================
QDRANT_ENDPOINT=http://localhost:6333

# ===========================================
# EMBEDDING DIMENSIONS
# ===========================================
EMBEDDING_DIMENSIONS=768

# ===========================================
# IN-MEMORY VECTOR STORE (OPTIONAL)
# ===========================================
# DB=memory   # no database needed; lore is re-embedded on every start

# ===========================================
# VOICE (OPTIONAL) -- see docs/scenes.md
# ===========================================
# scripts/run-voice-scene.sh sets these for you.
# GAMERAG_VOICE_DIR=./models/whisper:./models/piper   # where bare model file names in YAML resolve
# STT_MODEL_PATH=./models/whisper/ggml-base.en.bin     # whisper.cpp model for every NPC
# TTS_ENDPOINT=http://127.0.0.1:8880                  # Kokoro / OpenAI-compatible speech server
# TTS_API_KEY=                                        # only for hosted speech APIs
# TTS_EXECUTABLE_PATH=./models/piper-venv/bin/piper   # Piper CLI, for engine: piper
# KOKORO=0                                            # hosted demo image: disable the bundled Kokoro
# KOKORO_THREADS=2                                    # override Kokoro's CPU thread count
